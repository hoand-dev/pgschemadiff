  add and validate domain check: add_domain_check target=domain_type "App ""Schema"."Positive""Domain"
    transactional=true new_unit=false isolated=true sql=ALTER DOMAIN "App ""Schema"."Positive""Domain" ADD CONSTRAINT "positive" CHECK (VALUE > 0) NOT VALID
    transactional=true new_unit=false isolated=true sql=DO $pgschemadiff$
  DECLARE
      old_transaction record;
  BEGIN
      IF EXISTS (
          SELECT 1
          FROM pg_catalog.pg_stat_activity
          WHERE datname = pg_catalog.current_database()
            AND pid <> pg_catalog.pg_backend_pid()
            AND state IS DISTINCT FROM 'idle'
            AND xact_start IS NULL
      ) THEN
          RAISE EXCEPTION USING MESSAGE =
              'Cannot safely validate a domain check without visibility into all '
              || 'active transactions; grant pg_read_all_stats or drain transactions manually.';
      END IF;
  
      IF EXISTS (
          SELECT 1
          FROM pg_catalog.pg_prepared_xacts
          WHERE database = pg_catalog.current_database()
      ) THEN
          RAISE EXCEPTION 'Cannot safely validate a domain check while prepared transactions exist.';
      END IF;
  
      FOR old_transaction IN
          SELECT pid, backend_start, xact_start
          FROM pg_catalog.pg_stat_activity
          WHERE datname = pg_catalog.current_database()
            AND pid <> pg_catalog.pg_backend_pid()
            AND xact_start IS NOT NULL
      LOOP
          LOOP
              PERFORM pg_catalog.pg_stat_clear_snapshot();
              EXIT WHEN NOT EXISTS (
                  SELECT 1
                  FROM pg_catalog.pg_stat_activity
                  WHERE pid = old_transaction.pid
                    AND backend_start = old_transaction.backend_start
                    AND xact_start = old_transaction.xact_start
              );
              PERFORM pg_catalog.pg_sleep(0.1);
          END LOOP;
      END LOOP;
  END
  $pgschemadiff$
    transactional=true new_unit=false isolated=true sql=ALTER DOMAIN "App ""Schema"."Positive""Domain" VALIDATE CONSTRAINT "positive"
