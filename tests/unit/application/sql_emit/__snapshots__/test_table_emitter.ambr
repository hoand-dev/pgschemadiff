# serializer version: 1
# name: test_alter_table_attrs_emits_supported_fields_and_clears_comment
  tuple(
    'ALTER TABLE "Sales"."Order""Items" OWNER TO "new_owner"',
    'ALTER TABLE "Sales"."Order""Items" SET TABLESPACE "archive"',
    'COMMENT ON TABLE "Sales"."Order""Items" IS NULL',
  )
# ---
# name: test_create_default_partition_uses_default_bound
  tuple(
    'CREATE TABLE "Sales"."events_default" PARTITION OF "Sales"."events" DEFAULT',
  )
# ---
# name: test_create_partition_child_uses_catalog_bound_without_repeating_keyword
  tuple(
    'CREATE TABLE "Sales"."events_2026" PARTITION OF "Sales"."events" FOR VALUES FROM (\'2026-01-01\') TO (\'2027-01-01\')',
  )
# ---
# name: test_create_partition_root_uses_full_pg_get_partkeydef_clause
  tuple(
    'CREATE TABLE "Sales"."events" ("created_at" date) PARTITION BY RANGE (created_at)',
  )
# ---
# name: test_create_subpartition_child_emits_partition_bound_and_key
  tuple(
    'CREATE TABLE "Sales"."events_2026_q1" PARTITION OF "Sales"."events_2026" FOR VALUES FROM (\'2026-01-01\') TO (\'2026-04-01\') PARTITION BY RANGE (created_at)',
  )
# ---
# name: test_create_table_sorts_columns_ignores_constraints_and_emits_followups
  tuple(
    'CREATE TABLE "Sales"."Order""Items" ("Created At" text COLLATE "C" NOT NULL, "select" integer GENERATED BY DEFAULT AS IDENTITY (START WITH 5 INCREMENT BY 2 MINVALUE 1 MAXVALUE 999 CACHE 8 CYCLE), "total" integer GENERATED ALWAYS AS (price * qty) STORED NOT NULL, "say""what" text DEFAULT \'it\'\'s ready\'::text)',
    'ALTER TABLE "Sales"."Order""Items" OWNER TO "Role""Owner"',
    'ALTER TABLE "Sales"."Order""Items" SET TABLESPACE "fast space"',
    'COMMENT ON TABLE "Sales"."Order""Items" IS \'Customer\'\'s order\'',
  )
# ---
# name: test_drop_table_is_restrict
  tuple(
    'DROP TABLE "Sales"."Order""Items" RESTRICT',
  )
# ---
# name: test_rename_table_changes_schema_after_renaming
  tuple(
    'ALTER TABLE "Old ""Schema"."old" RENAME TO "New""Name"',
    'ALTER TABLE "Old ""Schema"."New""Name" SET SCHEMA "New Schema"',
  )
# ---
# name: test_rename_table_same_schema_emits_one_statement
  tuple(
    'ALTER TABLE "Sales"."old" RENAME TO "new"',
  )
# ---
