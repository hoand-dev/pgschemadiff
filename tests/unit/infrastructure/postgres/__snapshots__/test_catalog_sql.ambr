# serializer version: 1
# name: test_catalog_sql_snapshot[columns.sql]
  '''
  -- catalog/columns.sql
  -- Returns all columns for user-defined tables and partitioned tables.
  -- Excludes dropped columns (attisdropped) and system columns (attnum <= 0).
  -- Excludes system schemas (pg_catalog, information_schema, pg_toast, pg_temp_*).
  -- Result columns:
  --   schema_name        text       -- owning schema
  --   table_name         text       -- owning table
  --   column_name        text       -- pg_attribute.attname
  --   ordinal_position   int        -- 1-based column number (pg_attribute.attnum)
  --   data_type          text       -- format_type(atttypid, atttypmod)
  --   is_nullable        bool       -- true if column allows NULL (NOT attnotnull)
  --   default_expr       text|null  -- pg_get_expr(adbin, adrelid) for DEFAULT, null otherwise
  --   collation          text|null  -- SQL identifier fragment, qualified outside pg_catalog
  --   is_identity        bool       -- true when attidentity != ''
  --   identity_generated text|null  -- 'ALWAYS' or 'BY DEFAULT' (when is_identity), null otherwise
  --   is_generated       bool       -- true when attgenerated = 's' (stored generated)
  --   is_virtual_generated bool     -- true when attgenerated = 'v' (virtual generated)
  --   generated_expr     text|null  -- pg_get_expr(adbin, adrelid) for stored/virtual generated cols
  SELECT
      n.nspname                                            AS schema_name,
      c.relname                                            AS table_name,
      a.attname                                            AS column_name,
      a.attnum                                             AS ordinal_position,
      format_type(a.atttypid, a.atttypmod)                AS data_type,
      NOT a.attnotnull                                     AS is_nullable,
      CASE
          WHEN a.attgenerated <> '' THEN NULL
          WHEN ad.adbin IS NOT NULL
              THEN pg_get_expr(ad.adbin, ad.adrelid)
          ELSE NULL
      END                                                  AS default_expr,
      CASE
          WHEN a.attcollation <> 0
               AND a.attcollation <> t.typcollation
              THEN CASE
                  WHEN collation_namespace.nspname = 'pg_catalog'
                      THEN format('%I', col.collname)
                  ELSE format('%I.%I', collation_namespace.nspname, col.collname)
              END
          ELSE NULL
      END                                                  AS collation,
      a.attidentity != ''                                  AS is_identity,
      CASE a.attidentity
          WHEN 'a' THEN 'ALWAYS'
          WHEN 'd' THEN 'BY DEFAULT'
          ELSE NULL
      END                                                  AS identity_generated,
      a.attgenerated = 's'                                 AS is_generated,
      a.attgenerated = 'v'                                 AS is_virtual_generated,
      CASE
          WHEN a.attgenerated IN ('s', 'v') AND ad.adbin IS NOT NULL
              THEN pg_get_expr(ad.adbin, ad.adrelid)
          ELSE NULL
      END                                                  AS generated_expr
  FROM pg_catalog.pg_attribute a
  JOIN pg_catalog.pg_class c
      ON c.oid = a.attrelid
  JOIN pg_catalog.pg_namespace n
      ON n.oid = c.relnamespace
  JOIN pg_catalog.pg_type t
      ON t.oid = a.atttypid
  LEFT JOIN pg_catalog.pg_attrdef ad
      ON ad.adrelid = a.attrelid
     AND ad.adnum   = a.attnum
  LEFT JOIN pg_catalog.pg_collation col
      ON col.oid = a.attcollation
  LEFT JOIN pg_catalog.pg_namespace collation_namespace
      ON collation_namespace.oid = col.collnamespace
  WHERE c.relkind IN ('r', 'p')
    AND a.attnum > 0
    AND NOT a.attisdropped
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
  ORDER BY n.nspname, c.relname, a.attnum
  
  '''
# ---
# name: test_catalog_sql_snapshot[composite_types.sql]
  '''
  -- catalog/composite_types.sql
  -- Returns standalone, non-extension-owned composite types and live attributes.
  -- Table row types are excluded by requiring the backing relation kind 'c'.
  -- Result columns:
  --   schema_name     text       -- owning schema
  --   type_name       text       -- composite type name
  --   attribute_position int|null -- pg_attribute.attnum
  --   attribute_name  text|null  -- NULL for an empty composite
  --   data_type       text|null  -- format_type(atttypid, atttypmod)
  --   collation       text|null  -- SQL identifier fragment for explicit collation
  --   owner           text       -- role owning the composite type
  SELECT
      n.nspname AS schema_name,
      t.typname AS type_name,
      a.attnum AS attribute_position,
      a.attname AS attribute_name,
      pg_catalog.format_type(a.atttypid, a.atttypmod) AS data_type,
      CASE
          WHEN a.attcollation <> 0
               AND a.attcollation <> attribute_type.typcollation
              THEN CASE
                  WHEN collation_namespace.nspname = 'pg_catalog'
                      THEN pg_catalog.format('%I', col.collname)
                  ELSE pg_catalog.format('%I.%I', collation_namespace.nspname, col.collname)
              END
          ELSE NULL
      END AS collation,
      pg_catalog.pg_get_userbyid(t.typowner) AS owner
  FROM pg_catalog.pg_type AS t
  JOIN pg_catalog.pg_namespace AS n
      ON n.oid = t.typnamespace
  JOIN pg_catalog.pg_class AS composite_relation
      ON composite_relation.oid = t.typrelid
     AND composite_relation.relkind = 'c'
  LEFT JOIN pg_catalog.pg_attribute AS a
      ON a.attrelid = composite_relation.oid
     AND a.attnum > 0
     AND NOT a.attisdropped
  LEFT JOIN pg_catalog.pg_type AS attribute_type
      ON attribute_type.oid = a.atttypid
  LEFT JOIN pg_catalog.pg_collation AS col
      ON col.oid = a.attcollation
  LEFT JOIN pg_catalog.pg_namespace AS collation_namespace
      ON collation_namespace.oid = col.collnamespace
  WHERE t.typtype = 'c'
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS d
        WHERE d.classid = 'pg_catalog.pg_type'::regclass
          AND d.objid = t.oid
          AND d.deptype = 'e'
    )
  ORDER BY n.nspname, t.typname, a.attnum;
  
  '''
# ---
# name: test_catalog_sql_snapshot[constraints.sql]
  '''
  -- catalog/constraints.sql
  -- Returns all constraints (PK, unique, check, FK, exclusion) on user-defined tables.
  -- Excludes system schemas (pg_catalog, information_schema, pg_toast, pg_temp_*).
  -- Result columns:
  --   schema_name        text       -- table's owning schema
  --   table_name         text       -- constrained table
  --   constraint_name    text       -- pg_constraint.conname
  --   constraint_type    text       -- 'p'=PK, 'u'=unique, 'c'=check, 'f'=FK, 'x'=exclusion
  --   definition         text       -- pg_get_constraintdef(con.oid, true)
  --   inherited          bool       -- conparentid <> 0 OR NOT conislocal
  --   ref_schema         text|null  -- referenced schema (FK only, null otherwise)
  --   ref_table          text|null  -- referenced table  (FK only, null otherwise)
  --   deferrable         bool       -- con.condeferrable
  --   initially_deferred bool       -- con.condeferred
  SELECT
      n.nspname                                            AS schema_name,
      c.relname                                            AS table_name,
      con.conname                                          AS constraint_name,
      con.contype::text                                    AS constraint_type,
      pg_get_constraintdef(con.oid, true)                  AS definition,
      (con.conparentid <> 0 OR NOT con.conislocal)         AS inherited,
      rn.nspname                                           AS ref_schema,
      rc.relname                                           AS ref_table,
      con.condeferrable                                    AS deferrable,
      con.condeferred                                      AS initially_deferred
  FROM pg_catalog.pg_constraint con
  JOIN pg_catalog.pg_class c
      ON c.oid = con.conrelid
  JOIN pg_catalog.pg_namespace n
      ON n.oid = c.relnamespace
  -- Referenced relation (populated only for foreign-key constraints, contype='f')
  LEFT JOIN pg_catalog.pg_class rc
      ON rc.oid = con.confrelid
  LEFT JOIN pg_catalog.pg_namespace rn
      ON rn.oid = rc.relnamespace
  WHERE con.contype IN ('p', 'u', 'c', 'f', 'x')
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
  ORDER BY n.nspname, c.relname, con.conname
  
  '''
# ---
# name: test_catalog_sql_snapshot[domain_types.sql]
  '''
  -- catalog/domain_types.sql
  -- Returns user domains, local checks, and whether any live table column reaches
  -- the domain through an array, composite, range, or multirange container.
  -- Result columns:
  --   schema_name        text
  --   domain_name        text
  --   base_type          text -- format_type(typbasetype, typtypmod)
  --   collation          text -- quoted catalog identifier, when applicable
  --   default_expr       text -- pg_get_expr(typdefaultbin, 0)
  --   not_null           boolean
  --   check_name         text -- NULL when the domain has no local checks
  --   check_expression   text -- pg_get_expr(conbin, 0)
  --   check_validated    boolean
  --   owner              text
  --   used_in_container  boolean
  WITH RECURSIVE type_walk(type_oid, inside_container, type_path) AS (
      SELECT
          a.atttypid,
          FALSE,
          ARRAY[a.atttypid]::oid[]
      FROM pg_catalog.pg_attribute AS a
      JOIN pg_catalog.pg_class AS owning_relation
          ON owning_relation.oid = a.attrelid
      JOIN pg_catalog.pg_namespace AS owning_namespace
          ON owning_namespace.oid = owning_relation.relnamespace
      WHERE owning_relation.relkind IN ('r', 'p')
        AND a.attnum > 0
        AND NOT a.attisdropped
        AND owning_namespace.nspname NOT LIKE 'pg_%'
        AND owning_namespace.nspname != 'information_schema'
        AND owning_namespace.nspname != 'pgschemadiff'
        AND NOT EXISTS (
            SELECT 1
            FROM pg_catalog.pg_depend AS relation_dependency
            WHERE relation_dependency.classid = 'pg_catalog.pg_class'::regclass
              AND relation_dependency.objid = owning_relation.oid
              AND relation_dependency.deptype = 'e'
        )
  
      UNION ALL
  
      SELECT
          next_type.type_oid,
          type_walk.inside_container OR next_type.is_container,
          type_walk.type_path || next_type.type_oid
      FROM type_walk
      JOIN pg_catalog.pg_type AS current_type
          ON current_type.oid = type_walk.type_oid
      JOIN LATERAL (
          SELECT current_type.typelem AS type_oid, TRUE AS is_container
          WHERE current_type.typelem <> 0
  
          UNION ALL
  
          SELECT attribute.atttypid AS type_oid, TRUE AS is_container
          FROM pg_catalog.pg_class AS composite_relation
          JOIN pg_catalog.pg_attribute AS attribute
              ON attribute.attrelid = composite_relation.oid
             AND attribute.attnum > 0
             AND NOT attribute.attisdropped
          WHERE current_type.typtype = 'c'
            AND composite_relation.oid = current_type.typrelid
            AND composite_relation.relkind = 'c'
  
          UNION ALL
  
          SELECT range_type.rngsubtype AS type_oid, TRUE AS is_container
          FROM pg_catalog.pg_range AS range_type
          WHERE range_type.rngtypid = current_type.oid
             OR range_type.rngmultitypid = current_type.oid
  
          UNION ALL
  
          SELECT current_type.typbasetype AS type_oid, FALSE AS is_container
          WHERE current_type.typtype = 'd'
            AND current_type.typbasetype <> 0
      ) AS next_type
          ON TRUE
      WHERE NOT next_type.type_oid = ANY(type_walk.type_path)
  )
  SELECT
      n.nspname AS schema_name,
      t.typname AS domain_name,
      pg_catalog.format_type(t.typbasetype, t.typtypmod) AS base_type,
      CASE
          WHEN t.typcollation = 0 THEN NULL
          WHEN collation_namespace.nspname = 'pg_catalog'
              THEN pg_catalog.format('%I', domain_collation.collname)
          ELSE pg_catalog.format('%I.%I', collation_namespace.nspname, domain_collation.collname)
      END AS collation,
      CASE
          WHEN t.typdefaultbin IS NULL THEN NULL
          ELSE pg_catalog.pg_get_expr(t.typdefaultbin, 0)
      END AS default_expr,
      t.typnotnull AS not_null,
      domain_check.conname AS check_name,
      pg_catalog.pg_get_expr(domain_check.conbin, 0) AS check_expression,
      domain_check.convalidated AS check_validated,
      pg_catalog.pg_get_userbyid(t.typowner) AS owner,
      EXISTS (
          SELECT 1
          FROM type_walk
          WHERE type_walk.type_oid = t.oid
            AND type_walk.inside_container
      ) AS used_in_container
  FROM pg_catalog.pg_type AS t
  JOIN pg_catalog.pg_namespace AS n
      ON n.oid = t.typnamespace
  LEFT JOIN pg_catalog.pg_collation AS domain_collation
      ON domain_collation.oid = t.typcollation
  LEFT JOIN pg_catalog.pg_namespace AS collation_namespace
      ON collation_namespace.oid = domain_collation.collnamespace
  LEFT JOIN pg_catalog.pg_constraint AS domain_check
      ON domain_check.contypid = t.oid
     AND domain_check.contype = 'c'
     AND domain_check.conislocal
  WHERE t.typtype = 'd'
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS domain_dependency
        WHERE domain_dependency.classid = 'pg_catalog.pg_type'::regclass
          AND domain_dependency.objid = t.oid
          AND domain_dependency.deptype = 'e'
    )
  ORDER BY n.nspname, t.typname, domain_check.conname;
  
  '''
# ---
# name: test_catalog_sql_snapshot[enums.sql]
  '''
  -- catalog/enums.sql
  -- Returns non-extension-owned enum types and labels in PostgreSQL sort order.
  -- Result columns:
  --   schema_name text       -- owning schema
  --   enum_name   text       -- pg_type.typname
  --   labels      text[]     -- labels ordered by pg_enum.enumsortorder
  --   owner       text|null  -- role owning the enum type
  SELECT
      n.nspname AS schema_name,
      t.typname AS enum_name,
      COALESCE(
          array_agg(e.enumlabel ORDER BY e.enumsortorder)
              FILTER (WHERE e.enumlabel IS NOT NULL),
          '{}'::text[]
      ) AS labels,
      pg_catalog.pg_get_userbyid(t.typowner) AS owner
  FROM pg_catalog.pg_type AS t
  JOIN pg_catalog.pg_namespace AS n
      ON n.oid = t.typnamespace
  -- LEFT JOIN: PostgreSQL allows enums with no labels.
  LEFT JOIN pg_catalog.pg_enum AS e
      ON e.enumtypid = t.oid
  WHERE t.typtype = 'e'
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS d
        WHERE d.classid = 'pg_catalog.pg_type'::regclass
          AND d.objid = t.oid
          AND d.deptype = 'e'
    )
  GROUP BY n.nspname, t.typname, t.typowner
  ORDER BY n.nspname, t.typname;
  
  '''
# ---
# name: test_catalog_sql_snapshot[extensions.sql]
  '''
  -- catalog/extensions.sql
  -- Returns all currently installed PostgreSQL extensions and their metadata.
  -- Result columns:
  --   extension_name     text  -- extension name
  --   installed_version  text  -- currently installed version
  --   installed_schema   text  -- schema containing extension objects
  --   comment            text  -- optional extension comment
  SELECT
      e.extname AS extension_name,
      e.extversion AS installed_version,
      n.nspname AS installed_schema,
      pg_catalog.obj_description(e.oid, 'pg_extension') AS comment
  FROM pg_catalog.pg_extension AS e
  LEFT JOIN pg_catalog.pg_namespace AS n ON n.oid = e.extnamespace
  ORDER BY e.extname
  
  '''
# ---
# name: test_catalog_sql_snapshot[indexes.sql]
  '''
  -- catalog/indexes.sql
  -- Returns all indexes on user-defined tables (including primary-key indexes).
  -- Excludes system schemas (pg_catalog, information_schema, pg_toast, pg_temp_*).
  -- Result columns:
  --   schema_name       text       -- table's owning schema
  --   table_name        text       -- indexed table name
  --   index_name        text       -- pg_class.relname for the index object
  --   index_method      text       -- pg_am.amname (btree, hash, gist, gin, brin, spgist, …)
  --   is_unique         bool       -- pg_index.indisunique
  --   is_primary        bool       -- pg_index.indisprimary
  --   is_exclusion      bool       -- pg_index.indisexclusion
  --   partitioned       bool       -- index relation has relkind 'I'
  --   attached_to_parent bool      -- child index is attached to a parent index
  --   index_definition  text       -- full CREATE [UNIQUE] INDEX … statement
  --   include_columns   text[]      -- names after the first indnkeyatts index attributes
  --   constraint_name   text|null   -- owning PK/UNIQUE/EXCLUSION constraint, if any
  --   predicate         text|null  -- WHERE clause expression or null (non-partial indexes)
  SELECT
      n.nspname                                            AS schema_name,
      c.relname                                            AS table_name,
      ic.relname                                           AS index_name,
      am.amname                                            AS index_method,
      i.indisunique                                        AS is_unique,
      i.indisprimary                                       AS is_primary,
      i.indisexclusion                                     AS is_exclusion,
      ic.relkind = 'I'                                     AS partitioned,
      EXISTS (SELECT 1 FROM pg_catalog.pg_inherits WHERE inhrelid = i.indexrelid)
                                                           AS attached_to_parent,
      pg_get_indexdef(i.indexrelid)                        AS index_definition,
      ARRAY(
          SELECT a.attname::text
          FROM generate_series(i.indnkeyatts, i.indnatts - 1) AS k(position)
          JOIN pg_catalog.pg_attribute a
              ON a.attrelid = i.indrelid
             AND a.attnum = i.indkey[k.position]
          ORDER BY k.position
      )                                                    AS include_columns,
      con.conname                                          AS constraint_name,
      CASE
          WHEN i.indpred IS NOT NULL
              THEN pg_get_expr(i.indpred, i.indrelid)
          ELSE NULL
      END                                                  AS predicate
  FROM pg_catalog.pg_index i
  JOIN pg_catalog.pg_class c
      ON c.oid = i.indrelid
  JOIN pg_catalog.pg_class ic
      ON ic.oid = i.indexrelid
  JOIN pg_catalog.pg_namespace n
      ON n.oid = c.relnamespace
  JOIN pg_catalog.pg_am am
      ON am.oid = ic.relam
  LEFT JOIN pg_catalog.pg_constraint con
      ON con.conindid = i.indexrelid
     AND con.contype IN ('p', 'u', 'x')
  WHERE n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
  ORDER BY n.nspname, c.relname, ic.relname
  
  '''
# ---
# name: test_catalog_sql_snapshot[schemas.sql]
  '''
  -- catalog/schemas.sql
  -- Returns all user-defined schemas, excluding built-in system schemas.
  -- Result columns:
  --   schema_name  text  -- pg_namespace.nspname
  --   owner        text  -- role owning the schema
  --   comment      text  -- optional schema comment
  SELECT
      n.nspname AS schema_name,
      pg_catalog.pg_get_userbyid(n.nspowner) AS owner,
      pg_catalog.obj_description(n.oid, 'pg_namespace') AS comment
  FROM pg_catalog.pg_namespace AS n
  WHERE n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
  ORDER BY n.nspname
  
  '''
# ---
# name: test_catalog_sql_snapshot[sequence_prerequisites.sql]
  '''
  -- catalog/sequence_prerequisites.sql
  -- Returns sequence dependencies recorded for column defaults via pg_depend.
  -- No default SQL is parsed; dependent -> prerequisite direction is preserved.
  -- Result columns: dependent_schema, dependent_table, dependent_column,
  --                 sequence_schema, sequence_name
  SELECT DISTINCT
      table_namespace.nspname AS dependent_schema,
      table_class.relname AS dependent_table,
      table_attribute.attname AS dependent_column,
      sequence_namespace.nspname AS sequence_schema,
      sequence_class.relname AS sequence_name
  FROM pg_catalog.pg_attrdef AS column_default
  JOIN pg_catalog.pg_class AS table_class
      ON table_class.oid = column_default.adrelid
  JOIN pg_catalog.pg_namespace AS table_namespace
      ON table_namespace.oid = table_class.relnamespace
  JOIN pg_catalog.pg_attribute AS table_attribute
      ON table_attribute.attrelid = column_default.adrelid
     AND table_attribute.attnum = column_default.adnum
     AND table_attribute.attnum > 0
     AND NOT table_attribute.attisdropped
  JOIN pg_catalog.pg_depend AS sequence_dependency
      ON sequence_dependency.classid = 'pg_catalog.pg_attrdef'::regclass
     AND sequence_dependency.objid = column_default.oid
     AND sequence_dependency.refclassid = 'pg_catalog.pg_class'::regclass
     AND sequence_dependency.deptype = 'n'
  JOIN pg_catalog.pg_class AS sequence_class
      ON sequence_class.oid = sequence_dependency.refobjid
     AND sequence_class.relkind = 'S'
  JOIN pg_catalog.pg_namespace AS sequence_namespace
      ON sequence_namespace.oid = sequence_class.relnamespace
  WHERE table_class.relkind IN ('r', 'p')
     AND left(table_namespace.nspname, 3) != 'pg_'
    AND table_namespace.nspname != 'information_schema'
    AND table_namespace.nspname != 'pgschemadiff'
     AND left(sequence_namespace.nspname, 3) != 'pg_'
    AND sequence_namespace.nspname != 'information_schema'
    AND sequence_namespace.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS table_extension_dependency
        WHERE table_extension_dependency.classid = 'pg_catalog.pg_class'::regclass
          AND table_extension_dependency.objid = table_class.oid
          AND table_extension_dependency.deptype = 'e'
    )
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS sequence_extension_dependency
        WHERE sequence_extension_dependency.classid = 'pg_catalog.pg_class'::regclass
          AND sequence_extension_dependency.objid = sequence_class.oid
          AND sequence_extension_dependency.deptype = 'e'
    )
  ORDER BY dependent_schema, dependent_table, dependent_column,
           sequence_schema, sequence_name;

  
  '''
# ---
# name: test_catalog_sql_snapshot[sequences.sql]
  '''
  -- catalog/sequences.sql
  -- Returns non-extension-owned, non-identity sequences and schema options.
  -- Runtime state (last_value/is_called) is deliberately not queried.
  -- Result columns:
  --   schema_name, sequence_name, data_type, start_value, increment_by,
  --   min_value, max_value, cache_size, cycle, owner, owned_schema,
  --   owned_table, owned_column
  SELECT
      sequence_namespace.nspname AS schema_name,
      sequence_class.relname AS sequence_name,
      format_type(sequence_options.seqtypid, NULL) AS data_type,
      sequence_options.seqstart AS start_value,
      sequence_options.seqincrement AS increment_by,
      sequence_options.seqmin AS min_value,
      sequence_options.seqmax AS max_value,
      sequence_options.seqcache AS cache_size,
      sequence_options.seqcycle AS cycle,
      pg_catalog.pg_get_userbyid(sequence_class.relowner) AS owner,
      owned_namespace.nspname AS owned_schema,
      owned_relation.relname AS owned_table,
      owned_attribute.attname AS owned_column
  FROM pg_catalog.pg_class AS sequence_class
  JOIN pg_catalog.pg_sequence AS sequence_options
      ON sequence_options.seqrelid = sequence_class.oid
  JOIN pg_catalog.pg_namespace AS sequence_namespace
      ON sequence_namespace.oid = sequence_class.relnamespace
  LEFT JOIN pg_catalog.pg_depend AS ownership
      ON ownership.classid = 'pg_catalog.pg_class'::regclass
     AND ownership.objid = sequence_class.oid
     AND ownership.refclassid = 'pg_catalog.pg_class'::regclass
     AND ownership.deptype = 'a'
  LEFT JOIN pg_catalog.pg_class AS owned_relation
      ON owned_relation.oid = ownership.refobjid
  LEFT JOIN pg_catalog.pg_namespace AS owned_namespace
      ON owned_namespace.oid = owned_relation.relnamespace
  LEFT JOIN pg_catalog.pg_attribute AS owned_attribute
      ON owned_attribute.attrelid = ownership.refobjid
     AND owned_attribute.attnum = ownership.refobjsubid
     AND owned_attribute.attnum > 0
     AND NOT owned_attribute.attisdropped
  WHERE sequence_class.relkind = 'S'
     AND left(sequence_namespace.nspname, 3) != 'pg_'
    AND sequence_namespace.nspname != 'information_schema'
    AND sequence_namespace.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS identity_dependency
        WHERE identity_dependency.classid = 'pg_catalog.pg_class'::regclass
          AND identity_dependency.objid = sequence_class.oid
          AND identity_dependency.refclassid = 'pg_catalog.pg_class'::regclass
          AND identity_dependency.deptype = 'i'
    )
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS extension_dependency
        WHERE extension_dependency.classid = 'pg_catalog.pg_class'::regclass
          AND extension_dependency.objid = sequence_class.oid
          AND extension_dependency.deptype = 'e'
    )
  ORDER BY sequence_namespace.nspname, sequence_class.relname;

  
  '''
# ---
# name: test_catalog_sql_snapshot[tables.sql]
  '''
  -- catalog/tables.sql
  -- Returns all user-defined tables and partitioned tables from pg_catalog.
  -- Excludes system schemas (pg_catalog, information_schema, pg_toast, pg_temp_*).
  -- Result columns:
  --   schema_name          text      -- owning schema
  --   table_name           text      -- table name
  --   unlogged             bool      -- true when pg_class.relpersistence = 'u'
  --   partition_strategy   text|null -- 'h' hash / 'l' list / 'r' range, null if not partitioned
  --   partition_expr       text|null -- pg_get_partkeydef(c.oid) or null
  --   partition_of_schema  text|null -- parent schema if this table IS a partition
  --   partition_of_table   text|null -- parent table name if this table IS a partition
  --   partition_bound      text|null -- pg_get_expr(c.relpartbound, c.oid) if this IS a partition
  SELECT
      n.nspname                                          AS schema_name,
      c.relname                                          AS table_name,
      c.relpersistence = 'u'                              AS unlogged,
      pt.partstrat::text                                 AS partition_strategy,
      CASE
          WHEN pt.partrelid IS NOT NULL
              THEN pg_get_partkeydef(c.oid)
          ELSE NULL
      END                                                AS partition_expr,
      pn.nspname                                         AS partition_of_schema,
      pc.relname                                         AS partition_of_table,
      CASE
          WHEN c.relispartition
              THEN pg_get_expr(c.relpartbound, c.oid)
          ELSE NULL
      END                                                AS partition_bound
  FROM pg_catalog.pg_class c
  JOIN pg_catalog.pg_namespace n
      ON n.oid = c.relnamespace
  -- Partition key info (present only for PARTITIONED tables, i.e. relkind='p')
  LEFT JOIN pg_catalog.pg_partitioned_table pt
      ON pt.partrelid = c.oid
  -- Parent info (present only when this table IS a partition)
  LEFT JOIN pg_catalog.pg_inherits inh
      ON inh.inhrelid = c.oid
  LEFT JOIN pg_catalog.pg_class pc
      ON pc.oid = inh.inhparent
  LEFT JOIN pg_catalog.pg_namespace pn
      ON pn.oid = pc.relnamespace
  WHERE c.relkind IN ('r', 'p')
    AND n.nspname NOT LIKE 'pg_%'
    AND n.nspname != 'information_schema'
    AND n.nspname != 'pgschemadiff'
  ORDER BY n.nspname, c.relname
  
  '''
# ---
# name: test_catalog_sql_snapshot[type_prerequisites.sql]
  '''
  -- catalog/type_prerequisites.sql
  -- Returns enum/composite/domain types required by table columns, composite
  -- attributes, and domain base types.
  -- Array columns depend on their element type. System, reserved, and extension-owned
  -- objects are excluded on both sides of each dependency.
  -- Result columns:
  --   dependent_kind   text -- 'table', 'composite_type', or 'domain_type'
  --   dependent_schema text -- schema owning the dependent object
  --   dependent_name   text -- dependent table or composite type name
  --   type_kind        text -- 'enum', 'composite_type', or 'domain_type'
  --   type_schema      text -- schema owning the prerequisite type
  --   type_name        text -- prerequisite type name
  WITH dependent_columns AS (
      SELECT
          'table'::text AS dependent_kind,
          table_namespace.nspname AS dependent_schema,
          table_class.relname AS dependent_name,
          CASE WHEN column_type.typelem <> 0 THEN column_type.typelem ELSE column_type.oid END
              AS prerequisite_type_oid
      FROM pg_catalog.pg_attribute AS a
      JOIN pg_catalog.pg_class AS table_class
          ON table_class.oid = a.attrelid
      JOIN pg_catalog.pg_namespace AS table_namespace
          ON table_namespace.oid = table_class.relnamespace
      JOIN pg_catalog.pg_type AS column_type
          ON column_type.oid = a.atttypid
      WHERE table_class.relkind IN ('r', 'p')
        AND a.attnum > 0
        AND NOT a.attisdropped
        AND table_namespace.nspname NOT LIKE 'pg_%'
        AND table_namespace.nspname != 'information_schema'
        AND table_namespace.nspname != 'pgschemadiff'
        AND NOT EXISTS (
            SELECT 1
            FROM pg_catalog.pg_depend AS d
            WHERE d.classid = 'pg_catalog.pg_class'::regclass
              AND d.objid = table_class.oid
              AND d.deptype = 'e'
        )
  
      UNION ALL
  
      SELECT
          'composite_type'::text AS dependent_kind,
          dependent_namespace.nspname AS dependent_schema,
          dependent_type.typname AS dependent_name,
          CASE WHEN attribute_type.typelem <> 0 THEN attribute_type.typelem ELSE attribute_type.oid END
              AS prerequisite_type_oid
      FROM pg_catalog.pg_type AS dependent_type
      JOIN pg_catalog.pg_class AS composite_relation
          ON composite_relation.oid = dependent_type.typrelid
         AND composite_relation.relkind = 'c'
      JOIN pg_catalog.pg_namespace AS dependent_namespace
          ON dependent_namespace.oid = dependent_type.typnamespace
      JOIN pg_catalog.pg_attribute AS a
          ON a.attrelid = composite_relation.oid
         AND a.attnum > 0
         AND NOT a.attisdropped
      JOIN pg_catalog.pg_type AS attribute_type
          ON attribute_type.oid = a.atttypid
      WHERE dependent_type.typtype = 'c'
        AND dependent_namespace.nspname NOT LIKE 'pg_%'
        AND dependent_namespace.nspname != 'information_schema'
        AND dependent_namespace.nspname != 'pgschemadiff'
        AND NOT EXISTS (
            SELECT 1
            FROM pg_catalog.pg_depend AS d
            WHERE d.classid = 'pg_catalog.pg_type'::regclass
              AND d.objid = dependent_type.oid
              AND d.deptype = 'e'
        )
  
      UNION ALL
  
      SELECT
          'domain_type'::text AS dependent_kind,
          domain_namespace.nspname AS dependent_schema,
          domain_type.typname AS dependent_name,
          CASE
              WHEN base_type.typelem <> 0 THEN base_type.typelem
              ELSE domain_type.typbasetype
          END AS prerequisite_type_oid
      FROM pg_catalog.pg_type AS domain_type
      JOIN pg_catalog.pg_namespace AS domain_namespace
          ON domain_namespace.oid = domain_type.typnamespace
      JOIN pg_catalog.pg_type AS base_type
          ON base_type.oid = domain_type.typbasetype
      WHERE domain_type.typtype = 'd'
        AND domain_namespace.nspname NOT LIKE 'pg_%'
        AND domain_namespace.nspname != 'information_schema'
        AND domain_namespace.nspname != 'pgschemadiff'
        AND NOT EXISTS (
            SELECT 1
            FROM pg_catalog.pg_depend AS d
            WHERE d.classid = 'pg_catalog.pg_type'::regclass
              AND d.objid = domain_type.oid
              AND d.deptype = 'e'
        )
  )
  SELECT DISTINCT
      dependencies.dependent_kind,
      dependencies.dependent_schema,
      dependencies.dependent_name,
      CASE prerequisite_type.typtype
          WHEN 'e' THEN 'enum'
          WHEN 'c' THEN 'composite_type'
          WHEN 'd' THEN 'domain_type'
      END AS type_kind,
      prerequisite_namespace.nspname AS type_schema,
      prerequisite_type.typname AS type_name
  FROM dependent_columns AS dependencies
  JOIN pg_catalog.pg_type AS prerequisite_type
      ON prerequisite_type.oid = dependencies.prerequisite_type_oid
  JOIN pg_catalog.pg_namespace AS prerequisite_namespace
      ON prerequisite_namespace.oid = prerequisite_type.typnamespace
  LEFT JOIN pg_catalog.pg_class AS prerequisite_relation
      ON prerequisite_relation.oid = prerequisite_type.typrelid
  WHERE (
          prerequisite_type.typtype = 'e'
          OR (prerequisite_type.typtype = 'c' AND prerequisite_relation.relkind = 'c')
          OR prerequisite_type.typtype = 'd'
      )
    AND prerequisite_namespace.nspname NOT LIKE 'pg_%'
    AND prerequisite_namespace.nspname != 'information_schema'
    AND prerequisite_namespace.nspname != 'pgschemadiff'
    AND NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend AS d
        WHERE d.classid = 'pg_catalog.pg_type'::regclass
          AND d.objid = prerequisite_type.oid
          AND d.deptype = 'e'
    )
  ORDER BY dependencies.dependent_kind, dependencies.dependent_schema,
           dependencies.dependent_name, type_schema, type_name;
  
  '''
# ---
